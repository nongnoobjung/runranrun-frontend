# Base URL of runranrun-api (server-side only; the browser never calls the API directly)
API_URL=http://localhost:4000
# Shows the "simulate payment" button on the payment page. Never enable in production.
ENABLE_DEV_TOOLS=true
# Same value as the API's WEB_PROXY_SECRET: passes each visitor's IP to the API for its per-IP rate limits.
# Without it every visitor shares the web server's address.
WEB_PROXY_SECRET=
# Hostnames of the three fronts served by this one app. Without a port they keep the port of the current request.
# Runner site (default localhost), organiser backoffice and platform admin; e.g. kao.run, organizer.kao.run, admin.kao.run in production.
# SITE_HOST=localhost
# ORGANIZER_HOST=organizer.localhost
# ADMIN_HOST=admin.localhost
